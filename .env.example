# Fill only the variables needed by the selected solver and scorer configs.
# Existing environment variables take precedence over this file.

# Codex solver (Astra configuration).
OPENAI_API_KEY=
# Optional OpenAI-compatible endpoint:
# OPENAI_BASE_URL=https://api.openai.com/v1

# DeepSeek scorer and DSH solver.
DEEPSEEK_API_KEY=

# Kimi Code through Fireworks.
FIREWORKS_API_KEY=

# GLM through ZCode.
GLM_API_KEY=

# Qwen through Codex.
QWEN_API_KEY=

# Claude Code subscription credentials on the machine running Claude Code.
CLAUDE_CODE_OAUTH_TOKEN=
